{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "jarvis",
  "mcp": {
    "time": {
      "type": "local",
      "command": ["uvx", "mcp-server-time"],
      "enabled": true
    },
    "gmail": {
      "type": "local",
      "command": ["npx", "-y", "@shinzolabs/gmail-mcp"],
      "environment": {
        "PORT": "0",
        "AUTH_SERVER_PORT": "34200"
      },
      "enabled": true
    }
  }
}
