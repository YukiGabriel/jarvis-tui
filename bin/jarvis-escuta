#!/usr/bin/env python3
"""Jarvis-escuta — daemon de wake-word: ouve "hey jarvis" e despacha o comando.

Fluxo: arecord contínuo → openWakeWord (hey_jarvis, ONNX) → chime Razo
→ grava comando → transcreve (turbo) → abre a TUI com o texto pronto.

Uso: jarvis-escuta [--test] [--limiar 0.7] [--cmd-secs 6]
  --test: imprime scores ao vivo para calibrar, sem agir.
Env: JARVIS_WAKE_LIMIAR, JARVIS_CMD_SECS, JARVIS_COOLDOWN.
"""
from __future__ import annotations
import argparse, os, subprocess, sys, tempfile, time

LIMIAR = float(os.environ.get("JARVIS_WAKE_LIMIAR", "0.7"))
CMD_SECS = os.environ.get("JARVIS_CMD_SECS", "6")
COOLDOWN = float(os.environ.get("JARVIS_COOLDOWN", "20"))
CONSECUTIVAS = 6  # frames seguidos acima do limiar (~0.5s de frase)

import numpy as np
from openwakeword.model import Model


BIN = os.environ.get("JARVIS_BIN", os.path.join(os.path.expanduser("~"), ".local/bin"))
TUI = os.environ.get("JARVIS_TUI", os.path.join(BIN, "jarvis-tui"))
ARECORD = os.environ.get("JARVIS_ARECORD", "/usr/bin/arecord")


def chime() -> None:
    subprocess.run([f"{BIN}/jarvis-falar", "Pois não, senhor"],
                   capture_output=True, timeout=60)


def gravar_comando(secs: str) -> str:
    tmp = tempfile.NamedTemporaryFile(delete=False, suffix=".wav", prefix="jarvis-cmd-")
    tmp.close()
    subprocess.run([ARECORD, "-q", "-d", secs, "-f", "S16_LE", "-r", "16000",
                    "-c", "1", tmp.name], capture_output=True, timeout=int(secs) + 15)
    try:
        p = subprocess.run([f"{BIN}/jarvis-transcrever", tmp.name], capture_output=True,
                           text=True, timeout=180)
        return (p.stdout or "").strip()
    finally:
        try:
            os.unlink(tmp.name)
        except OSError:
            pass


def abrir_tui(texto: str) -> None:
    subprocess.Popen(
        ["setsid", "-f", "kitty", "-T", "Jarvis", "fish", "-c",
          f'"{TUI}" --prompt "{texto}"; exec fish'],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
    )


def atender() -> None:
    try:
        chime()
        texto = gravar_comando(CMD_SECS)
        if texto:
            abrir_tui(texto.replace('"', ""))
    except Exception as e:
        print(f"atender falhou: {e}", flush=True)


def main() -> None:
    ap = argparse.ArgumentParser(description="Jarvis-escuta")
    ap.add_argument("--test", action="store_true", help="Só mostra scores, sem agir")
    ap.add_argument("--limiar", type=float, default=LIMIAR)
    ap.add_argument("--cmd-secs", default=CMD_SECS)
    args = ap.parse_args()

    model = Model(wakeword_models=["hey_jarvis"], inference_framework="onnx")
    arecord = subprocess.Popen(
        [ARECORD, "-q", "-f", "S16_LE", "-r", "16000", "-c", "1", "-t", "raw"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=4096,
    )
    assert arecord.stdout is not None
    seguidos, ultimo = 0, 0.0
    print("Jarvis-escuta online. Diga: hey jarvis.", flush=True)
    try:
        while True:
            raw = arecord.stdout.read(2560)  # 80ms a 16kHz/16-bit
            if len(raw) < 2560:
                time.sleep(0.05)
                continue
            audio = np.frombuffer(raw, dtype=np.int16)
            try:
                score = float(model.predict(audio).get("hey_jarvis", 0.0))
            except Exception:
                continue
            if args.test and (score > 0.1):
                print(f"score={score:.3f}", flush=True)
            seguidos = seguidos + 1 if score >= args.limiar else 0
            agora = time.time()
            if seguidos >= CONSECUTIVAS and not args.test and agora - ultimo > COOLDOWN:
                ultimo = agora
                seguidos = 0
                atender()
    except KeyboardInterrupt:
        pass
    finally:
        try:
            arecord.terminate()
        except Exception:
            pass


if __name__ == "__main__":
    main()
