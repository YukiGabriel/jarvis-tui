#!/bin/sh
# Jarvis — cutuca a cada 2 min se a TUI do Jarvis não estiver aberta.
if pgrep -f "[j]arvis-tui" >/dev/null 2>&1; then exit 0; fi
COMUM="$(dirname "$0")/.jarvis-comum"
[ -r "$COMUM" ] || COMUM="${JARVIS_BIN:-$HOME/.local/bin}/.jarvis-comum"
# shellcheck source=./.jarvis-comum
. "$COMUM"

jarvis_falar_fundo 'Senhor ainda não abriu o Jarvis. Toque para conversar.'
acao=$(notify-send -A iniciar="Iniciar Sistema" -t 60000 "Jarvis" "Senhor ainda não abriu o Jarvis. Toque para conversar." 2>/dev/null); rc=$?
if [ $rc -eq 0 ] && [ "$acao" = "iniciar" ]; then
  jarvis_abrir_chat "Jarvis, me receba com o briefing sem eu precisar digitar nada."
fi
