#!/bin/sh
# Jarvis — gatilhos de briefing conforme a rotina do senhor. Silencioso (sem voz).
# Modos: manha | correria | noite | fds. Sem argumento: decide pela hora do login.
# Teste: JARVIS_TEST_DOW=3 JARVIS_TEST_HM=12:30 jarvis-briefing
PEND="$HOME/.local/share/jarvis-voice/pending"
mkdir -p "$PEND"
COMUM="$(dirname "$0")/.jarvis-comum"
[ -r "$COMUM" ] || COMUM="${JARVIS_BIN:-$HOME/.local/bin}/.jarvis-comum"
# shellcheck source=./.jarvis-comum
. "$COMUM"

prompt_do_modo() {
  case "$1" in
    manha) printf '%s' "Jarvis, bom dia. Me de o briefing completo da manha, com meus compromissos de hoje, sem eu precisar digitar nada.";;
    correria) printf '%s' "Jarvis, modo correria. Resumo de 1 linha, sem eu precisar digitar nada.";;
    noite) printf '%s' "Jarvis, boa noite. Receba-me com o resumo do dia.";;
    fds) printf '%s' "Jarvis, briefing de fim de semana, sem eu precisar digitar nada.";;
    *) printf '%s' "Jarvis, me receba com o briefing sem eu precisar digitar nada.";;
  esac
}

notify() {
  texto="$1"; modo="$2"
  # Voz junto: fala em segundo plano, sem travar o botão. JARVIS_NOTIF_VOZ=0 emudece.
  jarvis_falar_fundo "$texto"
  acao=$(notify-send -A iniciar="Iniciar Sistema" -t 60000 "Jarvis" "$texto" 2>/dev/null); rc=$?
  if [ $rc -eq 0 ] && [ "$acao" = "iniciar" ]; then
    jarvis_abrir_chat "$(prompt_do_modo "$modo")"
  fi
  # sem fallback com segunda notificação: dismiss/timeout (rc!=0) não é erro, é só o senhor ignorando.
}
pend() { printf '%s\n' "$(date -Is) $1" > "$PEND/$1"; }

MODE="$1"
if [ -z "$MODE" ]; then
  DOW="${JARVIS_TEST_DOW:-$(date +%u)}"   # 1=seg .. 7=dom
  HM="${JARVIS_TEST_HM:-$(date +%H:%M)}"  # zero-padded, comparação textual vale
  if [ "$HM" \< "06:00" ]; then exit 0; fi              # madrugada: nada
  if [ "$DOW" -ge 6 ]; then MODE="fds"
  elif [ "$HM" \< "11:40" ]; then MODE="manha"
  elif [ "$HM" \< "18:00" ]; then MODE="correria"
  else MODE="noite"; fi
fi

case "$MODE" in
  manha)   notify "Bom dia, senhor. Toque para receber o briefing no chat." "$MODE";;
  correria) notify "Modo correria — toque para o resumo de 1 linha no chat." "$MODE";;
  noite)   notify "Boa noite, senhor. Toque para o resumo do dia no chat." "$MODE";;
  fds)     notify "Bom dia, senhor. Toque para o briefing de fim de semana no chat." "$MODE";;
  *) echo "Modo inválido: $MODE (manha|correria|noite|fds)" >&2; exit 1;;
esac
pend "$MODE"
